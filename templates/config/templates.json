  {
    "name": "Test Security Template",
    "description": "Template for security testing",
    "format": "html",
    "templateType": "custom",
    "content": "\n        <html>\n          <head><title>Dangerous Template</title></head>\n          <body>\n            {{#each issues}}\n            <div>{{this.message}}</div>\n            {{#if (lookup this \"constructor\")}}\n              <script>alert(\"Constructor access\")</script>\n            {{/if}}\n            {{#if (this.constructor.prototype)}}\n              <script>alert(\"Prototype access\")</script>\n            {{/if}}\n            {{/each}}\n          </body>\n        </html>\n      ",
    "sections": [
      {
        "id": "custom-content",
        "name": "Custom Content",
        "type": "custom",
        "enabled": true,
        "order": 1
      }
    ],
    "styles": {
      "theme": "light"
    },
    "variables": [],
    "id": "18d57daf-4c84-44a7-812b-12ddb7aae538",
    "createdAt": "2025-10-13T14:55:59.911Z",
    "updatedAt": "2025-10-13T14:55:59.911Z"
  },
  {
    "name": "Test Security Template",
    "description": "Template for security testing",
    "format": "html",
    "templateType": "custom",
    "content": "\n        <html>\n          <head><title>Safe Template</title></head>\n          <body>\n            <h1>{{reportTitle}}</h1>\n            {{#each issues}}\n              <div class=\"issue {{this.type}}\">\n                <h3>{{this.message}}</h3>\n                <p>File: {{this.filePath}}:{{this.lineNumber}}</p>\n                {{#if this.fixable}}\n                  <span class=\"fixable\">This issue can be fixed automatically</span>\n                {{/if}}\n                {{#unless this.suggestion}}\n                  <span class=\"no-suggestion\">No suggestion available</span>\n                {{/unless}}\n              </div>\n            {{/each}}\n            <p>Total issues: {{summary.totalIssues}}</p>\n            <p>Generated: {{formatDate timestamp}}</p>\n          </body>\n        </html>\n      ",
    "sections": [
      {
        "id": "custom-content",
        "name": "Custom Content",
        "type": "custom",
        "enabled": true,
        "order": 1
      }
    ],
    "styles": {
      "theme": "light"
    },
    "variables": [],
    "id": "c8f728c8-a70c-444e-9a74-9095c7207944",
    "createdAt": "2025-10-13T14:55:59.912Z",
    "updatedAt": "2025-10-13T14:55:59.912Z"
  },
  {
    "name": "Test Security Template",
    "description": "Template for security testing",
    "format": "html",
    "templateType": "custom",
    "content": "\n        <html>\n          <head><title>{{reportTitle}}</title></head>\n          <body>\n            <h1>{{reportTitle}}</h1>\n            <div>Author: {{customFields.authorName}}</div>\n            <div>Department: {{customFields.department}}</div>\n            <div>Notes: {{customFields.notes}}</div>\n            {{#each summary.topIssues}}\n              <div class=\"issue\">\n                <h3>{{this.message}}</h3>\n                <p>File: {{this.filePath}}:{{this.lineNumber}}</p>\n                {{#if this.suggestion}}\n                  <p>Suggestion: {{this.suggestion}}</p>\n                {{/if}}\n              </div>\n            {{/each}}\n          </body>\n        </html>\n      ",
    "sections": [
